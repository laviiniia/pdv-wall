# Copie para .env.local e preencha. Nunca commite o .env.local.

# ─── Banco de dados (obrigatório) ────────────────────────────────────────────
# Local:    rode `npm run db:start` e use a URL que ele imprimir.
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable

# ─── Autenticação (obrigatório a partir do Módulo 3) ─────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_EXPIRES_IN=7d

# Usuário admin criado pelo seed (apenas desenvolvimento)
SEED_ADMIN_EMAIL=admin@pdv.local
SEED_ADMIN_PASSWORD=admin123

# ─── Aplicação ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (opcional por enquanto: Storage/Realtime) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Serviços externos (futuro) ──────────────────────────────────────────────
# E-mail (recuperação de senha). Sem os dois, em dev o e-mail é só impresso no terminal do `npm run dev`.
RESEND_API_KEY=
EMAIL_FROM=PDV Wall <nao-responda@seu-dominio.com>
REDIS_REST_URL=
REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
