# Copie para .env.local e preencha. Nunca commite o .env.local.

# ─── Banco de dados (obrigatório) ────────────────────────────────────────────
# Local:    rode `npm run db:start` (as portas abaixo são as padrão do servidor "pdv-wall").
# Supabase: Project Settings → Database → Connection string (URI).
DATABASE_URL=
# Banco temporário usado pelo `prisma migrate dev` para validar migrations.
# Local: o `prisma dev` expõe um servidor separado para isso (porta seguinte à do banco).
# Supabase: deixe vazio (o Prisma cria um shadow DB sozinho).
SHADOW_DATABASE_URL=
# Máximo de conexões do pool. Local (`prisma dev`): 1, pois ele só aceita uma conexão por vez.
# Supabase/produção: deixe vazio.
DATABASE_POOL_MAX=1

# ─── Autenticação (obrigatório a partir do Módulo 3) ─────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=
REFRESH_TOKEN_EXPIRES_IN=

# Usuário admin criado pelo seed (apenas desenvolvimento)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Aplicação ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase (opcional por enquanto: Storage/Realtime) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Serviços externos (futuro) ──────────────────────────────────────────────
# E-mail via Resend (recuperação de senha e convite). Sem os dois, em dev o e-mail é só impresso no terminal.
# - Crie a chave em https://resend.com/api-keys (permissão "Sending access").
# - Antes de verificar um domínio, use EMAIL_FROM=PDV Wall <onboarding@resend.dev>: só entrega para o e-mail da sua conta no Resend.
# - Para enviar a qualquer pessoa, verifique seu domínio no Resend e use um remetente dele.
# - Teste em Configurações › Empresa › "Enviar e-mail de teste para mim".
RESEND_API_KEY=
EMAIL_FROM=PDV Wall <nao-responda@seu-dominio.com>
# Opcional: endereço para onde vão as respostas.
EMAIL_REPLY_TO=
REDIS_REST_URL=
REDIS_REST_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
